# ─────────────────────────────────────────────────────────────
#  Spectra Systems — environment
#  Everything runs fully offline with ZERO configuration.
#  The variables below are optional upgrades.
# ─────────────────────────────────────────────────────────────

# Compiler Engine (Fastify) listen port
PORT=4000

# Canvas → Compiler URL (server-side proxy target)
COMPILER_URL=http://localhost:4000

# ── Optional: open-ended generation via Anthropic ──
# Leave SPECTRA_LLM unset (or "deterministic") to run the offline,
# zero-key deterministic compiler. Set to "anthropic" AND provide a
# key to unlock LLM generation. Generated code still passes the full
# validate → compile → repair guarantee loop before it can mount.
SPECTRA_LLM=deterministic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8
