# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Datenbank ---------------------------------------------------------------
# App-Rolle (unterliegt Row Level Security)
DATABASE_URL=postgres://workforce_app:workforce_app_dev@localhost:5432/workforce_dev
# Owner-Rolle (Migrationen, Auth-Tabellen, Systemjobs)
DATABASE_ADMIN_URL=postgres://workforce_owner:workforce_owner_dev@localhost:5432/workforce_dev

# --- Auth & Verschlüsselung --------------------------------------------------
# In Produktion zwingend setzen: `openssl rand -hex 32`
AUTH_SECRET=dev-only-secret-change-me-please
# 32-Byte-Hex-Key für AES-256-GCM (Integration-Credentials): `openssl rand -hex 32`
CREDENTIAL_ENCRYPTION_KEY=94a1c9f2b7d34e58a6c0f1e2d3b4a5968778695a4b3c2d1e0f9e8d7c6b5a4a39

# --- KI-Provider (optional) --------------------------------------------------
# Ohne Key läuft die Plattform im Demo-/Sandbox-Modus mit deterministischem
# ScriptedProvider. Mit Key werden echte Anthropic-Modelle verwendet.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
# Embeddings (Voyage AI). Ohne Key: lokaler, deterministischer Embedding-Fallback.
# VOYAGE_API_KEY=pa-...

# --- Billing (optional) ------------------------------------------------------
# Ohne Keys: MockBillingProvider (im UI als "Simulierte Abrechnung" markiert).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- E-Mail-Versand (optional) -----------------------------------------------
# Ohne SMTP_URL werden ausgehende Mails in der Outbox (DB) gespeichert und im
# UI angezeigt, statt real versendet zu werden.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="WORKFORCE OS <noreply@localhost>"

# --- Google OAuth für Gmail/Google-Calendar-Adapter (optional) ----------------
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# --- Demo --------------------------------------------------------------------
ALLOW_DEMO_SEED=true
