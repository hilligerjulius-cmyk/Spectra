# ─────────────────────────────────────────────────────────────
#  Spectra Systems — environment
#  Runs fully offline with ZERO config (deterministic templates).
#  Add a provider key below to unlock LLM generation + the model picker.
# ─────────────────────────────────────────────────────────────

# ── LLM generation (optional) ──
# Add either or both. The UI only offers models whose key is present;
# generated code always passes the validate → compile → repair guarantee,
# and falls back to a template if the model call fails.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Model used when a request doesn't specify one (must be in the catalog and
# have its provider key set). Defaults to a balanced/fast available model.
# SPECTRA_DEFAULT_MODEL=claude-sonnet-5

# ── Optional: two-service topology ──
# Set COMPILER_URL to make the canvas proxy to a standalone Fastify Compiler
# Engine instead of running it in-process. Then run the compiler separately:
#   pnpm --filter @spectra/compiler start
# COMPILER_URL=http://localhost:4000

# Standalone Fastify compiler listen port (only used in two-service mode).
# PORT=4000
